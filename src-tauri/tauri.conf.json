{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dịch nhanh",
  "version": "1.0.0",
  "identifier": "com.translator.dichnhanh",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dịch nhanh",
        "url": "widget.html",
        "width": 360,
        "height": 470,
        "minWidth": 320,
        "minHeight": 400,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "visible": false,
        "backgroundColor": "#202124"
      },
      {
        "label": "popup",
        "title": "Dịch nhanh",
        "url": "popup.html",
        "width": 300,
        "height": 168,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false,
        "backgroundColor": "#202124"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Dịch nhanh bằng AI và đọc to",
    "longDescription": "Widget dịch nhanh: bôi đen chữ và nhấn Alt để dịch, đọc to bằng giọng Supertonic-3 chạy trên CPU.",
    "resources": {
      "ort/onnxruntime.dll": "onnxruntime.dll",
      "ort/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "../.env": ".env",
      "../models/supertonic": "models/supertonic"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}